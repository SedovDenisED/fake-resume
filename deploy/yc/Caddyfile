	email denissedoved@icloud.com
}

resume.sde-lab.ru {
	encode gzip

	# Секретный path VLESS/XHTTP → дом через AWG (10.66.66.1).
	# Замени REPLACE_SECRET_PATH на длинную случайную строку (тот же path в sing-box).
	@vless path /REPLACE_SECRET_PATH /REPLACE_SECRET_PATH/*

	handle @vless {
		reverse_proxy 10.66.66.1:10000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			transport http {
				versions 1.1 2
			}
		}
	}

	# free_parking_space: /free-space* → дом :12817 по AWG
	handle /free-space* {
		reverse_proxy 10.66.66.1:12817 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		# Корень клона ветки facade
		root * /var/www/resume
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/resume-access.log
		format console
	}
}
